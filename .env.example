# ============================================================
# Product Image Finder & Catalog Generator - environment config
# Copy this file to .env and fill in real values.
# NEVER commit .env or real API keys to version control.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
DATABASE_PATH=server/data/app.db
STORAGE_DIR=storage
CORS_ORIGIN=http://localhost:5173

# --- Web search provider ---
# Choose ONE active provider: google_cse | firecrawl | serpapi | bing | none
# "none" disables live search; the app will clearly mark all products as
# "Search provider not configured" instead of returning fake results.
SEARCH_PROVIDER=none

# Google Programmable Search Engine (Custom Search JSON API)
# Free tier: 100 queries/day. https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Firecrawl (search + page scrape/extract in one call)
# https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# SerpAPI (Google/Bing results aggregator)
# https://serpapi.com/
SERPAPI_API_KEY=

# Bing Web Search API (Azure Cognitive Services)
BING_API_KEY=

# --- Processing / rate limiting ---
SEARCH_CONCURRENCY=3
SEARCH_RATE_LIMIT_MS=600
SEARCH_MAX_RETRIES=2
FETCH_TIMEOUT_MS=12000
MAX_UPLOAD_MB=20
MAX_IMAGE_MB=15

# --- Frontend (web/.env) ---
# VITE_API_URL=http://localhost:4000
