# ============================================================
# Product Image Finder & Catalog Generator - environment config
# Copy this file to .env and fill in real values.
# NEVER commit .env or real API keys to version control.
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
DATABASE_PATH=server/data/app.db
STORAGE_DIR=storage
CORS_ORIGIN=http://localhost:5173

# --- Search: direct on-site search, no API key ---
# Search runs by directly querying each of the 5 target retailers' own
# on-site search (server/src/services/searchProviders/sites/configs.ts) -
# hugoboss.com, farfetch.com, mrporter.com, selfridges.com, endclothing.com.
# There is no API key, no third-party search provider, and no quota to
# configure - search is always available. hugoboss.com and farfetch.com go
# through a real headless browser (Playwright) instead of a plain HTTP
# fetch - see README §1b - which needs a one-time browser download:
#   npx playwright install chromium -w server

# --- Processing / politeness ---
SEARCH_CONCURRENCY=3          # parallel products processed at once
# Minimum gap between two requests to the *same* retailer site - a
# politeness delay, not a cost control (there is no external quota).
SITE_SEARCH_DELAY_MS=1500
SITE_SEARCH_MAX_RETRIES=1
FETCH_TIMEOUT_MS=12000
# Page-load timeout for the headless-browser sites (hugoboss.com/
# farfetch.com) - longer than FETCH_TIMEOUT_MS since a real page load is
# slower than one HTTP request.
BROWSER_NAV_TIMEOUT_MS=20000
# Optional: point at a specific Chromium binary instead of Playwright's own
# downloaded browser (e.g. a Docker image with a system Chromium already
# installed). Leave unset for normal use.
# CHROMIUM_EXECUTABLE_PATH=
MAX_UPLOAD_MB=20
MAX_IMAGE_MB=15

# --- Frontend (web/.env) ---
# VITE_API_URL=http://localhost:4000
