{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:push": "tsx src/db/migrate.ts",
    "test": "tsx --test --test-reporter=spec $(find src -name '*.test.ts')",
    "smoke:sites": "tsx scripts/smokeTestSites.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.5.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.1",
    "mime-types": "^2.1.35",
    "multer": "^2.0.1",
    "p-limit": "^6.1.0",
    "pdfkit": "^0.15.1",
    "sharp": "^0.35.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.13.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
