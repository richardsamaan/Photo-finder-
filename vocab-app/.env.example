# ============================================================
# Vocabulary Intelligence Platform - environment config
# Copy this file to .env and fill in real values.
# NEVER commit .env or real API keys to version control.
# ============================================================

# --- Server ---
PORT=4001
NODE_ENV=development
DATABASE_PATH=server/data/app.db
STORAGE_DIR=storage
CORS_ORIGIN=http://localhost:5174

# --- AI providers (all optional) ---
# The core vocabulary bank, mastery engine, spaced repetition, testing modes,
# stats, and export DO NOT depend on any of these. They only unlock AI
# Conversation (Phase 10) and AI Content Generation (Phase 11) once added.
# AI_PROVIDER=none | anthropic | openai | gemini
AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Frontend (web/.env) ---
# VITE_API_URL=http://localhost:4001
